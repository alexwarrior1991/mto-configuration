# Plantilla de las credenciales que necesita el entorno local.
#
#   cp .env.example .env
#
# Docker Compose lee .env automaticamente. El fichero .env NO se versiona: es el sitio
# donde cada uno pone sus valores, y evita que una credencial real acabe en el repositorio
# por haberla escrito donde antes habia un valor de ejemplo.
#
# Estos valores son desechables y solo sirven para el stack local. Un entorno desplegado
# toma los suyos del gestor de secretos, nunca de un fichero del repositorio.

# PostgreSQL
POSTGRES_PASSWORD=mto_configuration_password
MTO_CONFIGURATION_DATASOURCE_PASSWORD=mto_configuration_password

# RabbitMQ
SPRING_RABBITMQ_PASSWORD=guest

# Keycloak: administrador del servidor local
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Keycloak: secreto de la cuenta de servicio con la que esta aplicacion llama a otras
KEYCLOAK_SERVICE_CLIENT_SECRET=mto-configuration-svc-secret
