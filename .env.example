# Plantilla de las credenciales que necesita el entorno local.
#
#   cp .env.example .env
#
# Docker Compose lee .env automaticamente. El fichero .env NO se versiona: es el sitio donde cada
# uno pone sus valores, y evita que una credencial real acabe en el repositorio por haberla escrito
# donde antes habia un valor de ejemplo.
#
# Estos valores son desechables y solo sirven para el entorno local. Un entorno desplegado toma los
# suyos del gestor de secretos, nunca de un fichero del repositorio.
#
# La infraestructura -PostgreSQL, Redis, RabbitMQ, Keycloak y el colector- la levanta mto-platform,
# no este repositorio. Los valores de abajo tienen que coincidir con los de SU .env.

# PostgreSQL
MTO_CONFIGURATION_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/mto_configuration_db
MTO_CONFIGURATION_DATASOURCE_USERNAME=mto_configuration_user
MTO_CONFIGURATION_DATASOURCE_PASSWORD=mto_configuration_password
MTO_CONFIGURATION_DB_SCHEMA=mto_configuration

# Redis
SPRING_DATA_REDIS_HOST=host.docker.internal
SPRING_DATA_REDIS_PASSWORD=mto_redis_password

# RabbitMQ. EL MISMO broker del que consume mto-stock: mientras cada repositorio levantaba el suyo,
# esta aplicacion publicaba en uno y mto-stock escuchaba en otro, y los mensajes no llegaban sin que
# nada diera error.
SPRING_RABBITMQ_HOST=host.docker.internal
SPRING_RABBITMQ_USERNAME=mto
SPRING_RABBITMQ_PASSWORD=mto

# Keycloak: secreto de la cuenta de servicio con la que esta aplicacion llama a otras.
# Tiene que coincidir con el campo "secret" de mto-configuration-svc en
# keycloak/mto-configuration-dev.json, que aplica mto-platform/keycloak/apply-partials.sh. En un
# entorno desplegado el secreto lo genera Keycloak al importar la parcial y se lee de su consola.
KEYCLOAK_SERVICE_CLIENT_SECRET=mto-configuration-svc-secret

# Puerto en el que se publica la aplicacion. mto-platform usa el mismo.
APP_PORT=8081
